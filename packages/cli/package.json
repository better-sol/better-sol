{
  "name": "@better-sol/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "better-sol": "./dist/index.js"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && bun build src/index.ts --outdir dist --target node",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --fix .",
    "format:check": "oxlint .",
    "docs": "typedoc"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@solana/kit": "^6.8.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "ts-morph": "^28.0.0",
    "typescript": "catalog:"
  }
}
