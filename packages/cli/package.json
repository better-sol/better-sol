{
  "name": "@better-sol/cli",
  "imports": {
    "#*": "./src/*"
  },
  "version": "0.1.0-alpha.10",
  "description": "Write Solana programs in TypeScript. Transpile, compile, and deploy to Solana.",
  "license": "MIT",
  "type": "module",
