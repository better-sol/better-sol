{
  "name": "better-sol",
  "imports": {
    "#*": "./src/*"
  },
  "version": "0.1.0-alpha.3",
  "description": "Write Solana programs in TypeScript. Define programs, send transactions, query accounts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    },
    "./wallets": {
      "types": "./dist/wallets/wallet-adapter.d.ts",
      "import": "./dist/wallets/wallet-adapter.js"
    },
    "./wallets/reown": {
      "types": "./dist/wallets/reown.d.ts",
      "import": "./dist/wallets/reown.js"
    },
    "./wallets/privy": {
      "types": "./dist/wallets/privy.d.ts",
      "import": "./dist/wallets/privy.js"
    },
    "./wallets/dynamic": {
      "types": "./dist/wallets/dynamic.d.ts",
      "import": "./dist/wallets/dynamic.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --fix .",
    "format:check": "oxlint ."
  },
  "keywords": [
    "solana",
    "solana-sdk",
    "anchor",
    "typescript",
    "blockchain",
    "web3"
  ],
  "author": "powxenv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powxenv/better-sol.git",
    "directory": "packages/better-sol"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/powxenv/better-sol/tree/main/packages/better-sol",
  "dependencies": {
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.8.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/web3.js": "^1.98.4"
  }
}