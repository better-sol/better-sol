{
  "name": "better-sol",
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    },
    "./wallets": {
      "types": "./dist/wallets/index.d.ts",
      "import": "./dist/wallets/index.js"
    },
    "./wallets/wallet-adapter": {
      "types": "./dist/wallets/wallet-adapter.d.ts",
      "import": "./dist/wallets/wallet-adapter.js"
    },
    "./wallets/reown": {
      "types": "./dist/wallets/reown.d.ts",
      "import": "./dist/wallets/reown.js"
    },
    "./wallets/privy": {
      "types": "./dist/wallets/privy.d.ts",
      "import": "./dist/wallets/privy.js"
    },
    "./wallets/dynamic": {
      "types": "./dist/wallets/dynamic.d.ts",
      "import": "./dist/wallets/dynamic.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.build.json && bun build src/index.ts src/program.ts --outdir dist --target bun && bun build src/wallets/index.ts src/wallets/wallet-adapter.ts src/wallets/reown.ts src/wallets/privy.ts src/wallets/dynamic.ts --outdir dist/wallets --target bun --external @solana/wallet-adapter-react --external @solana/wallet-adapter-base --external @privy-io/react-auth --external @dynamic-labs/sdk-react-core --external @dynamic-labs/solana --external @reown/appkit --external @reown/appkit-adapter-solana",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --fix .",
    "format:check": "oxlint .",
    "docs": "typedoc"
  },
  "dependencies": {
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.8.0"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "devDependencies": {
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/web3.js": "^1.98.4"
  }
}
